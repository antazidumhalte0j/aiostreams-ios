diff --git a/packages/web/src/lib/hosts/shell/ios.ts b/packages/web/src/lib/hosts/shell/ios.ts
new file mode 100644
index 00000000..50139397
--- /dev/null
+++ b/packages/web/src/lib/hosts/shell/ios.ts
@@ -0,0 +1,29 @@
+import type { Host } from '..';
+import { appBridge } from './bridge';
+import { appEngine } from './player';
+import { resolveYouTube } from './youtube';
+
+let fullscreen = false;
+
+/** Follows the iOS app's full screen, which hides the status bar and turns to landscape. */
+export function setupIos(): () => void {
+  const unsubscribe = appBridge()?.subscribe((m) => {
+    if (m.type === 'fullscreen') fullscreen = m.value;
+  });
+  return () => unsubscribe?.();
+}
+
+/** The iOS app: the page over AetherEngine, which draws the video beneath it. */
+export const iosHost: Host = {
+  name: 'ios-app',
+  device: () => ({ id: appBridge()?.deviceId, name: appBridge()?.device }),
+  player: appEngine,
+  playerFeatures: ['audio', 'chapters', 'headers'],
+  resolveYouTube,
+  fullscreen: {
+    active: () => fullscreen,
+    set: (on) => appBridge()?.send({ type: 'fullscreen', value: on }),
+  },
+  saveFile: (name, type, text) =>
+    appBridge()?.send({ type: 'save-file', name, mime: type, text }),
+};
